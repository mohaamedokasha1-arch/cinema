# Admin panel credentials. Copy to .env.local for local development and add the
# same values to the hosting provider's environment variables for deployments.
# Never commit real values.

# Optional. Defaults to "admin".
ADMIN_USERNAME=admin

# Output of: npm run admin:hash -- --generate
# Format: scrypt$N$r$p$salt$hash
ADMIN_PASSWORD_HASH=

# Random secret of 32+ characters used to sign the session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
